# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# --- fastn MCP gateway ---
# Confirm the exact URL and auth header in your fastn dashboard.
FASTN_MCP_URL=https://mcp.fastn.dev
FASTN_API_KEY=
FASTN_AUTH_HEADER=Authorization
FASTN_AUTH_SCHEME=Bearer
# Extra headers some gateways need, as JSON (example: {"x-fastn-space-id": "..."}).
FASTN_EXTRA_HEADERS={}
FASTN_TIMEOUT_SECONDS=30
FASTN_MAX_RETRIES=2
